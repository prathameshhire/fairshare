generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  avatarUrl    String?
  passwordHash String   // required — every user must have a password (registration enforces this)
  createdAt    DateTime @default(now())

  sentFriendRequests     Friendship[] @relation("requester")
  receivedFriendRequests Friendship[] @relation("addressee")
  expensesPaid           Expense[]    @relation("paidBy")
  expenseParticipants    ExpenseParticipant[]
  settlementsPaid        Settlement[] @relation("payer")
  settlementsReceived    Settlement[] @relation("payee")
  groupMemberships       GroupMember[]
}

// A Group is a shared expense context — typically a trip, household, or any
// recurring scenario where the same people split costs together. Expenses
// and settlements both belong to a group; balances will eventually be
// computed per-group.
model Group {
  id          String    @id @default(uuid())
  name        String
  archivedAt  DateTime? // null = active, set = archived (future use)
  createdAt   DateTime  @default(now())

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

// Join table — which users are in which groups.
// Composite primary key on (groupId, userId) prevents duplicate memberships.
model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id])
  user     User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id])
  addressee User @relation("addressee", fields: [addresseeId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal
  currency    String   @default("USD")
  paidById    String
  splitType   String   @default("even")
  createdAt   DateTime @default(now())
  // Optional — expenses can be "personal" splits between friends without
  // belonging to a group. Groups are a labeling/organization feature, not
  // a hard requirement. When null, the expense is a free-floating split.
  groupId     String?

  paidBy       User                 @relation("paidBy", fields: [paidById], references: [id])
  participants ExpenseParticipant[]
  group        Group?               @relation(fields: [groupId], references: [id])
}

model ExpenseParticipant {
  id         String   @id @default(uuid())
  expenseId  String
  userId     String
  amountOwed Decimal
  isSettled  Boolean  @default(false)
  createdAt  DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Settlement {
  id        String   @id @default(uuid())
  payerId   String
  payeeId   String
  amount    Decimal
  createdAt DateTime @default(now())
  // Optional, same reasoning as Expense.groupId
  groupId   String?

  payer User   @relation("payer", fields: [payerId], references: [id])
  payee User   @relation("payee", fields: [payeeId], references: [id])
  group Group? @relation(fields: [groupId], references: [id])
}